function setupImagePreview(
    input,
    preview,
    img,
    type
){
    input.addEventListener(
        "change",
        ()=>{
            const file =
            input.files[0];
            if(!file)
                return;
            if(!validateImage(file)){
                input.value =
                "";
                preview.classList.remove(
                    "show"
                );
                return;
            }
            const url =
            URL.createObjectURL(file);
            if(type === "entry"){
                if(entryObjectURL){
                    URL.revokeObjectURL(
                        entryObjectURL
                    );
                }
                entryObjectURL =
                url;
            }else{
                if(exitObjectURL){
                    URL.revokeObjectURL(
                        exitObjectURL
                    );
                }
                exitObjectURL =
                url;
            }
            img.src =
            url;
            preview.classList.add(
                "show"
            );
            updateAll();
            saveDraft();
        }
    );
}
