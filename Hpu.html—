<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050505">
<title>♛ نظام تقارير دوريات شرطة MESA ME ♛</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Marhey:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
    --gold:#d4af37;
    --gold2:#f8df78;
    --gold3:#fff0a8;
    --goldDark:#76580e;
    --black:#030303;
    --black2:#080808;
    --black3:#101010;
    --card:rgba(14,14,14,.88);
    --line:rgba(212,175,55,.25);
    --text:#f6f1df;
    --muted:#aaa38e;
    --green:#39d98a;
    --red:#ff5c5c;
    --blue:#5aa9ff;
    --shadow:0 25px 80px rgba(0,0,0,.75);
}
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}
html{
    scroll-behavior:smooth;
}
body{
    min-height:100vh;
    font-family:"Cairo",sans-serif;
    color:var(--text);
    background:
        radial-gradient(circle at 50% -10%,rgba(212,175,55,.16),transparent 30%),
        radial-gradient(circle at 10% 90%,rgba(212,175,55,.08),transparent 25%),
        radial-gradient(circle at 90% 50%,rgba(212,175,55,.05),transparent 30%),
        #020202;
    overflow-x:hidden;
}
/* =========================
   ROYAL BACKGROUND
========================= */
body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    opacity:.18;
    background-image:
        linear-gradient(rgba(212,175,55,.05) 1px,transparent 1px),
        linear-gradient(90deg,rgba(212,175,55,.05) 1px,transparent 1px);
    background-size:55px 55px;
    mask-image:linear-gradient(to bottom,black,transparent 85%);
    z-index:-4;
}
body::after{
    content:"";
    position:fixed;
    width:700px;
    height:700px;
    top:-350px;
    left:50%;
    transform:translateX(-50%);
    background:radial-gradient(circle,rgba(212,175,55,.15),transparent 65%);
    filter:blur(30px);
    pointer-events:none;
    z-index:-3;
}
.royal-frame{
    position:fixed;
    inset:12px;
    border:1px solid rgba(212,175,55,.18);
    pointer-events:none;
    z-index:100;
    border-radius:20px;
}
.royal-frame::before,
.royal-frame::after{
    content:"";
    position:absolute;
    width:70px;
    height:70px;
    border-color:var(--gold);
    opacity:.65;
}
.royal-frame::before{
    top:-1px;
    right:-1px;
    border-top:2px solid;
    border-right:2px solid;
    border-radius:0 20px 0 0;
}
.royal-frame::after{
    bottom:-1px;
    left:-1px;
    border-bottom:2px solid;
    border-left:2px solid;
    border-radius:0 0 0 20px;
}
.particles{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:-1;
    overflow:hidden;
}
.particle{
    position:absolute;
    width:3px;
    height:3px;
    border-radius:50%;
    background:var(--gold2);
    box-shadow:0 0 10px var(--gold);
    animation:floatParticle linear infinite;
    opacity:.65;
}
@keyframes floatParticle{
    0%{
        transform:translateY(110vh) translateX(0) scale(.4);
        opacity:0;
    }
    15%{
        opacity:.7;
    }
    85%{
        opacity:.7;
    }
    100%{
        transform:translateY(-10vh) translateX(80px) scale(1.2);
        opacity:0;
    }
}
/* =========================
   TOP BAR
========================= */
.topbar{
    width:min(1450px,94%);
    margin:25px auto 0;
    min-height:68px;
    padding:12px 20px;
    border:1px solid var(--line);
    border-radius:20px;
    background:rgba(8,8,8,.8);
    backdrop-filter:blur(18px);
    box-shadow:
        0 10px 40px rgba(0,0,0,.5),
        inset 0 0 30px rgba(212,175,55,.025);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    position:relative;
    z-index:5;
}
.top-status{
    display:flex;
    align-items:center;
    gap:12px;
}
.status-dot{
    width:11px;
    height:11px;
    border-radius:50%;
    background:var(--green);
    box-shadow:0 0 12px var(--green);
    animation:pulse 1.7s infinite;
}
@keyframes pulse{
    50%{
        opacity:.45;
        transform:scale(.75);
    }
}
.top-title{
    color:var(--gold2);
    font-weight:800;
    font-size:14px;
}
.top-sub{
    color:var(--muted);
    font-size:11px;
}
.clock-box{
    text-align:left;
}
.clock{
    font-family:"Marhey",sans-serif;
    font-size:20px;
    color:var(--gold2);
    font-weight:700;
}
.today-text{
    color:var(--muted);
    font-size:10px;
}
/* =========================
   MAIN
========================= */
.container{
    width:min(1250px,94%);
    margin:35px auto 80px;
}
.hero{
    text-align:center;
    position:relative;
    padding:45px 20px 35px;
}
.royal-badge{
    width:125px;
    height:125px;
    margin:0 auto 22px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    background:
        radial-gradient(circle at 35% 25%,#fff1a0,#d4af37 38%,#72550d 72%,#171000);
    border:3px solid #f1d96b;
    box-shadow:
        0 0 0 7px rgba(212,175,55,.08),
        0 0 45px rgba(212,175,55,.3),
        inset 0 0 30px rgba(0,0,0,.5);
    animation:royalFloat 4s ease-in-out infinite;
}
.royal-badge::before,
.royal-badge::after{
    content:"";
    position:absolute;
    inset:-12px;
    border:1px solid rgba(212,175,55,.3);
    border-radius:50%;
}
.royal-badge::after{
    inset:-20px;
    border-style:dashed;
    animation:spin 22s linear infinite;
}
@keyframes spin{
    to{
        transform:rotate(360deg);
    }
}
@keyframes royalFloat{
    50%{
        transform:translateY(-7px);
    }
}
.crown{
    font-size:65px;
    color:#090909;
    filter:drop-shadow(0 4px 5px rgba(255,255,255,.25));
}
.hero h1{
    font-family:"Marhey",sans-serif;
    font-size:clamp(28px,5vw,52px);
    color:var(--gold2);
    text-shadow:
        0 0 15px rgba(212,175,55,.25),
        0 3px 0 #3c2b05;
    margin-bottom:8px;
}
.hero h2{
    font-size:16px;
    color:#eee8d2;
    font-weight:700;
    letter-spacing:2px;
}
.hero p{
    margin-top:12px;
    color:var(--muted);
    font-size:13px;
}
/* =========================
   DASHBOARD
========================= */
.dashboard{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
    margin-bottom:22px;
}
.stat-card{
    min-height:105px;
    padding:18px;
    border:1px solid var(--line);
    border-radius:20px;
    background:
        linear-gradient(145deg,rgba(24,24,24,.95),rgba(7,7,7,.92));
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
    transition:.3s;
}
.stat-card:hover{
    transform:translateY(-4px);
    border-color:rgba(212,175,55,.55);
    box-shadow:
        0 20px 60px rgba(0,0,0,.75),
        0 0 25px rgba(212,175,55,.08);
}
.stat-card::after{
    content:"";
    position:absolute;
    width:100px;
    height:100px;
    left:-40px;
    bottom:-50px;
    background:
        radial-gradient(circle,rgba(212,175,55,.18),transparent 70%);
}
.stat-label{
    color:var(--muted);
    font-size:11px;
    margin-bottom:5px;
}
.stat-value{
    color:var(--gold2);
    font-size:22px;
    font-weight:900;
}
.stat-icon{
    position:absolute;
    left:17px;
    top:15px;
    font-size:24px;
    opacity:.65;
}
.completion{
    display:flex;
    align-items:center;
    gap:12px;
}
.completion-ring{
    width:55px;
    height:55px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:conic-gradient(var(--gold) 0deg,#222 0deg);
    position:relative;
}
.completion-ring::before{
    content:"";
    position:absolute;
    inset:6px;
    border-radius:50%;
    background:#090909;
}
.completion-number{
    position:relative;
    z-index:2;
    font-size:12px;
    font-weight:900;
    color:var(--gold2);
}
/* =========================
   MAIN CARD
========================= */
.main-card{
    position:relative;
    background:
        linear-gradient(145deg,rgba(18,18,18,.94),rgba(5,5,5,.97));
    border:1px solid var(--line);
    border-radius:28px;
    padding:28px;
    box-shadow:
        0 30px 100px rgba(0,0,0,.75),
        inset 0 1px 0 rgba(255,255,255,.025);
    overflow:hidden;
}
.main-card::before{
    content:"";
    position:absolute;
    top:0;
    right:10%;
    left:10%;
    height:1px;
    background:linear-gradient(90deg,transparent,var(--gold),transparent);
    box-shadow:0 0 20px var(--gold);
}
.section{
    margin-bottom:28px;
}
.section-head{
    display:flex;
    align-items:center;
    gap:13px;
    margin-bottom:17px;
    padding-bottom:12px;
    border-bottom:1px solid rgba(212,175,55,.13);
}
.section-number{
    min-width:38px;
    height:38px;
    border-radius:12px;
    display:grid;
    place-items:center;
    color:#0b0b0b;
    font-weight:900;
    background:
        linear-gradient(135deg,#fff0a3,#d4af37,#80610e);
    box-shadow:0 0 18px rgba(212,175,55,.18);
}
.section-title{
    font-size:16px;
    color:var(--gold2);
    font-weight:900;
}
.section-subtitle{
    font-size:10px;
    color:var(--muted);
    margin-top:2px;
}
.grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:17px;
}
.full{
    grid-column:1/-1;
}
.field{
    position:relative;
}
label{
    display:block;
    color:#ded7c2;
    font-size:12px;
    font-weight:700;
    margin-bottom:8px;
}
label span{
    color:var(--gold2);
}
input,
select,
textarea{
    width:100%;
    color:var(--text);
    background:rgba(0,0,0,.62);
    border:1px solid rgba(212,175,55,.2);
    border-radius:14px;
    padding:14px 15px;
    outline:none;
    font-family:"Cairo",sans-serif;
    font-size:13px;
    transition:.25s;
}
input:focus,
select:focus,
textarea:focus{
    border-color:var(--gold);
    box-shadow:
        0 0 0 3px rgba(212,175,55,.07),
        0 0 25px rgba(212,175,55,.08);
    background:rgba(12,12,12,.9);
}
input::placeholder,
textarea::placeholder{
    color:#625f55;
}
select option{
    background:#0b0b0b;
    color:white;
}
textarea{
    min-height:130px;
    resize:vertical;
}
.char-count{
    text-align:left;
    margin-top:5px;
    font-size:10px;
    color:var(--muted);
}
/* =========================
   STATUS
========================= */
.status-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}
.status-option{
    position:relative;
}
.status-option input{
    display:none;
}
.status-option label{
    cursor:pointer;
    padding:16px 12px;
    text-align:center;
    border:1px solid rgba(212,175,55,.15);
    border-radius:15px;
    background:rgba(0,0,0,.35);
    transition:.25s;
    color:#bbb;
}
.status-option label:hover{
    border-color:rgba(212,175,55,.4);
}
.status-option input:checked + label{
    color:var(--gold2);
    border-color:var(--gold);
    background:rgba(212,175,55,.08);
    box-shadow:0 0 25px rgba(212,175,55,.08);
}
.status-dot-mini{
    display:block;
    width:9px;
    height:9px;
    border-radius:50%;
    margin:0 auto 7px;
    background:var(--gold);
}
/* =========================
   DURATION
========================= */
.duration-card{
    min-height:88px;
    border:1px solid rgba(212,175,55,.2);
    border-radius:17px;
    padding:16px;
    background:rgba(212,175,55,.025);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
}
.duration-big{
    color:var(--gold2);
    font-size:28px;
    font-weight:900;
    direction:ltr;
}
.duration-caption{
    color:var(--muted);
    font-size:10px;
}
/* =========================
   IMAGE UPLOAD
========================= */
.upload-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:17px;
}
.upload-box{
    position:relative;
    min-height:260px;
    border:1px dashed rgba(212,175,55,.35);
    border-radius:20px;
    overflow:hidden;
    background:
        radial-gradient(circle at 50% 30%,rgba(212,175,55,.08),transparent 45%),
        rgba(0,0,0,.45);
    transition:.3s;
}
.upload-box:hover{
    border-color:var(--gold);
    box-shadow:0 0 30px rgba(212,175,55,.08);
}
.upload-box input{
    position:absolute;
    inset:0;
    opacity:0;
    cursor:pointer;
    z-index:5;
    height:100%;
}
.upload-content{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    pointer-events:none;
}
.upload-icon{
    width:65px;
    height:65px;
    border-radius:18px;
    display:grid;
    place-items:center;
    background:rgba(212,175,55,.08);
    border:1px solid rgba(212,175,55,.22);
    color:var(--gold2);
    font-size:28px;
    margin-bottom:12px;
}
.upload-title{
    color:#eee6cf;
    font-weight:800;
}
.upload-hint{
    color:var(--muted);
    font-size:10px;
    margin-top:5px;
}
.preview{
    position:absolute;
    inset:0;
    display:none;
    z-index:3;
    background:#000;
}
.preview.show{
    display:block;
}
.preview img{
    width:100%;
    height:100%;
    object-fit:cover;
    cursor:zoom-in;
}
.preview-overlay{
    position:absolute;
    right:10px;
    left:10px;
    bottom:10px;
    padding:9px 12px;
    border-radius:12px;
    background:rgba(0,0,0,.75);
    backdrop-filter:blur(10px);
    color:var(--gold2);
    font-size:11px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    pointer-events:none;
}
/* =========================
   SUMMARY
========================= */
.summary{
    border:1px solid rgba(212,175,55,.18);
    border-radius:20px;
    padding:18px;
    background:
        linear-gradient(135deg,rgba(212,175,55,.05),rgba(0,0,0,.3));
}
.summary-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}
.summary-item{
    padding:12px;
    border-radius:13px;
    background:rgba(0,0,0,.32);
}
.summary-label{
    font-size:9px;
    color:var(--muted);
    margin-bottom:3px;
}
.summary-value{
    font-size:12px;
    color:#eee8d5;
    font-weight:700;
    word-break:break-word;
}
/* =========================
   ACTIONS
========================= */
.actions{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:12px;
    margin-top:25px;
}
.btn{
    border:0;
    border-radius:16px;
    padding:15px 18px;
    font-family:"Cairo",sans-serif;
    font-weight:900;
    cursor:pointer;
    transition:.25s;
    font-size:13px;
}
.btn:hover{
    transform:translateY(-3px);
}
.btn-primary{
    color:#080808;
    background:
        linear-gradient(135deg,#fff0a0,#d4af37,#a17b16);
    box-shadow:0 8px 30px rgba(212,175,55,.17);
    position:relative;
    overflow:hidden;
}
.btn-primary::after{
    content:"";
    position:absolute;
    top:0;
    bottom:0;
    width:50px;
    background:rgba(255,255,255,.35);
    transform:skewX(-20deg) translateX(-120px);
    animation:shine 3.2s infinite;
}
@keyframes shine{
    55%,100%{
        transform:skewX(-20deg) translateX(250px);
    }
}
.btn-secondary{
    color:var(--gold2);
    background:#101010;
    border:1px solid rgba(212,175,55,.22);
}
.btn-danger{
    color:#ffaaaa;
    background:rgba(255,70,70,.05);
    border:1px solid rgba(255,80,80,.18);
}
.btn:disabled{
    opacity:.45;
    cursor:not-allowed;
    transform:none;
}
/* =========================
   AUTOSAVE
========================= */
.autosave{
    margin-top:13px;
    text-align:center;
    color:var(--muted);
    font-size:10px;
}
.autosave strong{
    color:var(--gold2);
}
/* =========================
   HISTORY
========================= */
.history-card{
    margin-top:22px;
    padding:22px;
    border:1px solid var(--line);
    border-radius:25px;
    background:rgba(10,10,10,.9);
}
.history-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    margin-bottom:15px;
}
.history-head h3{
    color:var(--gold2);
    font-size:16px;
}
.history-list{
    display:grid;
    gap:9px;
}
.history-item{
    display:grid;
    grid-template-columns:1.5fr 1fr 1fr 1fr;
    gap:10px;
    align-items:center;
    padding:13px;
    border-radius:14px;
    background:rgba(255,255,255,.025);
    border:1px solid rgba(212,175,55,.08);
}
.history-item small{
    display:block;
    color:var(--muted);
    font-size:9px;
}
.history-item strong{
    color:#e8e0c9;
    font-size:11px;
}
.empty-history{
    text-align:center;
    padding:25px;
    color:var(--muted);
    font-size:11px;
}
/* =========================
   MODALS
========================= */
.modal{
    position:fixed;
    inset:0;
    z-index:1000;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:rgba(0,0,0,.84);
    backdrop-filter:blur(14px);
}
.modal.show{
    display:flex;
}
.modal-card{
    width:min(620px,100%);
    max-height:90vh;
    overflow:auto;
    border:1px solid rgba(212,175,55,.45);
    border-radius:27px;
    padding:25px;
    background:
        radial-gradient(circle at 50% 0,rgba(212,175,55,.09),transparent 45%),
        #090909;
    box-shadow:
        0 30px 100px #000,
        0 0 60px rgba(212,175,55,.08);
    animation:modalIn .25s ease;
}
@keyframes modalIn{
    from{
        opacity:0;
        transform:translateY(20px) scale(.97);
    }
    to{
        opacity:1;
        transform:none;
    }
}
.modal-title{
    text-align:center;
    color:var(--gold2);
    font-family:"Marhey",sans-serif;
    font-size:22px;
    margin-bottom:6px;
}
.modal-sub{
    text-align:center;
    color:var(--muted);
    font-size:11px;
    margin-bottom:20px;
}
.confirm-preview{
    border:1px solid rgba(212,175,55,.14);
    border-radius:18px;
    padding:15px;
    background:rgba(0,0,0,.4);
}
.confirm-row{
    display:flex;
    justify-content:space-between;
    gap:15px;
    padding:8px 0;
    border-bottom:1px solid rgba(255,255,255,.04);
    font-size:11px;
}
.confirm-row:last-child{
    border-bottom:0;
}
.confirm-row span{
    color:var(--muted);
}
.confirm-row strong{
    color:#eee7d4;
}
.confirm-images{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:12px;
}
.confirm-images img{
    width:100%;
    height:140px;
    object-fit:cover;
    border-radius:13px;
    border:1px solid rgba(212,175,55,.15);
}
.modal-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:17px;
}
/* =========================
   LOADING
========================= */
.loading-ring{
    width:75px;
    height:75px;
    border-radius:50%;
    border:3px solid rgba(212,175,55,.15);
    border-top-color:var(--gold2);
    animation:spin .8s linear infinite;
    margin:0 auto 20px;
}
.loading-text{
    text-align:center;
    color:var(--gold2);
    font-weight:900;
}
.loading-sub{
    text-align:center;
    color:var(--muted);
    font-size:11px;
    margin-top:5px;
}
/* =========================
   TOAST
========================= */
.toast-container{
    position:fixed;
    bottom:25px;
    left:25px;
    z-index:2000;
    display:grid;
    gap:10px;
}
.toast{
    min-width:280px;
    max-width:380px;
    padding:15px 18px;
    border-radius:16px;
